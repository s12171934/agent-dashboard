#!/usr/bin/env python3
"""decision-hook — answer Claude Code's AskUserQuestion from the agent dashboard.

A PreToolUse hook (matcher "AskUserQuestion"). It registers the question with the dashboard server, waits for an
answer from the page, and hands it to Claude through updatedInput, so the terminal picker does not open. When the
page releases it (「터미널에서 답하기」), the wait runs past DECISION_WAIT, or the server cannot be reached, it prints
nothing and Claude shows the picker as usual. It never blocks the tool on its own failure.

  ~/.claude/settings.json → hooks.PreToolUse: [{"matcher": "AskUserQuestion",
      "hooks": [{"type": "command", "command": "<this file>", "timeout": 3600}]}]

Environment: DASH_URL (default http://127.0.0.1:8787), DECISION_WAIT seconds (default 1800; keep it under the
hook's timeout).
"""
import json
import os
import signal
import sys
import time
from urllib.request import Request, urlopen

URL = os.environ.get("DASH_URL", "http://127.0.0.1:8787").rstrip("/")
WAIT = float(os.environ.get("DECISION_WAIT", "1800"))


def call(path, body=None, timeout=5):
    data = None if body is None else json.dumps(body).encode()
    req = Request(URL + path, data=data, headers={"Content-Type": "application/json"}, method="POST" if data else "GET")
    with urlopen(req, timeout=timeout) as res:
        return json.load(res)


def main():
    try:
        event = json.load(sys.stdin)
        tool_input = event["tool_input"]
        rid = call("/api/decision/ask", {"session_id": event.get("session_id"), "tool_use_id": event.get("tool_use_id"),
                                         "cwd": event.get("cwd"), "questions": tool_input["questions"]})["id"]
    except Exception:
        return  # no dashboard: the terminal picker as usual

    def give_up(*_):
        try:
            call("/api/decision/done", {"id": rid}, timeout=2)
        except Exception:
            pass
        sys.exit(0)

    # Interrupted or timed out by Claude Code: close the card so the page does not offer a dead question.
    signal.signal(signal.SIGTERM, give_up)
    signal.signal(signal.SIGINT, give_up)
    end = time.time() + WAIT
    while time.time() < end:
        try:
            r = call(f"/api/decision/wait?id={rid}&t={min(25, max(1, int(end - time.time())))}", timeout=40)
        except Exception:
            time.sleep(2)  # the server restarted or blipped: its cards are gone, so this ends with "gone" next time
            continue
        if r.get("state") == "answered":
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "allow",
                "permissionDecisionReason": "대시보드에서 답함",
                "updatedInput": {**tool_input, "answers": r["answers"]},
            }}, ensure_ascii=False))
            return
        if r.get("state") != "pending":
            return  # released, cancelled or gone: the terminal picker
    give_up()


if __name__ == "__main__":
    main()
