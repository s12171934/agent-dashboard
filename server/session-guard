#!/bin/sh
# Resolve public bin/ symlinks before locating the native dispatcher.
set -eu
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  HERE="$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)"
  TARGET="$(readlink "$SCRIPT")"
  case "$TARGET" in /*) SCRIPT="$TARGET" ;; *) SCRIPT="$HERE/$TARGET" ;; esac
done
HERE="$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)"
# Hooks must fail open when the dashboard is not installed yet.
BINARY="${ADASH_BINARY:-$HERE/target/release/agent-dashboard}"
[ -x "$BINARY" ] || exit 0
exec "$HERE/run" session-guard "$@"
