#!/bin/sh
# Build and check the server from any directory. A local ignored toolchain is optional.
set -eu
HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(dirname "$HERE")"
cd "$HERE"
if command -v cargo >/dev/null 2>&1; then
  exec cargo "$@"
fi
if [ -x "$ROOT/.tools/cargo/bin/cargo" ]; then
  export CARGO_HOME="$ROOT/.tools/cargo"
  export RUSTUP_HOME="$ROOT/.tools/rustup"
  exec "$CARGO_HOME/bin/cargo" "$@"
fi
printf '%s\n' 'Rust toolchain missing: install Rust (https://rustup.rs), then run server/cargo build --release --locked.' >&2
exit 127
